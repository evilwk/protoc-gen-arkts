    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "protobufjs": "7.6.5"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
