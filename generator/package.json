{
  "name": "protoc-gen-arkts",
  "version": "0.4.0",
  "private": true,
  "description": "面向 HarmonyOS 的 ArkTS Protobuf message 代码生成器",
  "license": "Apache-2.0",
  "author": "evilwk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evilwk/protoc-gen-arkts.git",
    "directory": "generator"
  },
  "type": "module",
  "bin": {
    "protoc-gen-arkts": "bin/protoc-gen-arkts.js"
  },
  "scripts": {
